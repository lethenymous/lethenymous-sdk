{
  "name": "@lethenymous/sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for the audited Lethenymous zkCPMM program",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lethenymous/lethenymous-sdk.git"
  },
  "homepage": "https://github.com/lethenymous/lethenymous-sdk#readme",
  "bugs": {
    "url": "https://github.com/lethenymous/lethenymous-sdk/issues"
  },
  "files": [
    "dist",
    "README.md",
    "MERKLE_GENERATIONS.md",
    "CHECKPOINT_SCALABILITY.md",
    "ONCHAIN_MERKLE_ARCHIVE.md",
    "PAGED_MERKLE_AUDIT_REMEDIATION.md",
    "REAUD_SPENT_OUTPUT_RECOVERY.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:stress": "npm run build && node --test tests/stress/witness-capacity.mjs",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "test:reaud:sbf": "cargo test --manifest-path e2e/reaud-sbf/Cargo.toml --target-dir e2e/reaud-sbf/target --release --locked --test spent_output reaud_issued_then_consumed_outputs_restore_as_spent -- --nocapture",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@types/node": "^26.6.2",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
