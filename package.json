{
  "name": "@lethenymous/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the audited Lethenymous zkCPMM program",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "poseidon-lite": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.8.3"
  }
}
